generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Generated by Shopify CLI — do not remove
model Session {
  id          String    @id
  shop        String
  state       String
  isOnline    Boolean   @default(false)
  scope       String?
  expires     DateTime?
  accessToken String
  userId      BigInt?
  firstName   String?
  lastName    String?
  email       String?
  accountOwner Boolean  @default(false)
  locale      String?
  collaborator Boolean? @default(false)
  emailVerified Boolean? @default(false)
}

// Per-merchant Trunc API key and cached plan info
model ShopSettings {
  id        Int      @id @default(autoincrement())
  shop      String   @unique
  apiKey    String   @default("")
  planType  String   @default("free")
  planName  String   @default("Free")
  updatedAt DateTime @updatedAt
}

// Shortened links per merchant
model Link {
  id          Int      @id @default(autoincrement())
  shop        String
  originalUrl String
  shortCode   String   @unique
  shortUrl    String
  clicks      Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([shop])
}
