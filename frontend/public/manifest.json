  "shortcuts": [
    {
      "name": "Create Short URL",
      "short_name": "Shorten",
      "description": "Quickly create a new short URL",
      "url": "/dashboard?action=shorten",
      "icons": [
        {
          "src": "/icons/shortcut-shorten.png",
          "sizes": "96x96"
        }
      ]
    },
    {
      "name": "View Analytics",
      "short_name": "Analytics",
      "description": "View URL analytics",
      "url": "/analytics",
      "icons": [
        {
          "src": "/icons/shortcut-analytics.png",
          "sizes": "96x96"
        }
      ]
    }
  ],
  "share_target": {
    "action": "/dashboard",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "share_url"
    }
  },
  "protocol_handlers": [
    {
      "protocol": "web+trunc",
      "url": "/shorten?url=%s"
    }
  ],
  "related_applications": [],
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "edge_side_panel": {
    "preferred_width": 400
  },
  "file_handlers": [
    {
      "action": "/bulk",
      "accept": {
        "text/csv": [".csv"],
        "text/plain": [".txt"]
      }
    }
  ],
  "handle_links": "preferred",
  "display_override_description": "Optimized for mobile with adaptive UI and offline support"
}