# Debian (glibc) base on Node 22. Alpine/musl + Node 20 web-streams trigger
# "controller[kState].transformAlgorithm is not a function" during Next.js SSR
# streaming; node:22-bookworm-slim avoids it.
FROM node:22-bookworm-slim

WORKDIR /app

# Expose Next.js dev server port
EXPOSE 3000

# Health check hits a static, non-streaming asset (not the streaming "/" route,
# which can abort the SSR stream mid-flight). Node 22 has a global fetch.
HEALTHCHECK --interval=30s --timeout=3s --start-period=60s --retries=3 \
  CMD node -e "fetch('http://localhost:3000/favicon.ico').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

# Install deps on startup and run dev server
# This approach handles package.json changes dynamically
# First time will be slow (~30-60s), subsequent starts are fast
CMD ["sh", "-c", "npm ci && npm run dev"]
