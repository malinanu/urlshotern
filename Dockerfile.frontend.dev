FROM node:20-alpine

WORKDIR /app

# Install compatibility library for Next.js
RUN apk add --no-cache libc6-compat

# Expose Next.js dev server port
EXPOSE 3000

# Health check for frontend container
HEALTHCHECK --interval=30s --timeout=3s --start-period=60s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:3000 || exit 1

# Install deps on startup and run dev server
# This approach handles package.json changes dynamically
# First time will be slow (~30-60s), subsequent starts are fast
CMD ["sh", "-c", "npm ci && npm run dev"]
