# Production Environment Configuration
# Copy this file to .env.prod and fill in your actual values

# Database Configuration (using shared PostgreSQL with Odoo)
URLSHORTENER_DB_PASSWORD=your_secure_password_for_urlshortener_user

# Application Configuration
BASE_URL=https://trunc.site
JWT_SECRET=your_very_secure_jwt_secret_key_here_minimum_32_characters
JWT_ISSUER=trunc.site

# Frontend Configuration
# CRITICAL: Must match your production domain for API calls
# This is baked into the frontend during Docker build
NEXT_PUBLIC_API_URL=https://trunc.site

# OAuth Configuration (optional)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
# Must match the redirect URI registered in Google Console
# Register https://trunc.site/callback in Google Cloud Console > APIs & Services > Credentials
GOOGLE_REDIRECT_URL=https://trunc.site/callback

# GitHub OAuth Configuration (optional — for GitHub SSO)
# Create an OAuth App at: https://github.com/settings/applications/new
# Authorization callback URL: https://trunc.site/github-callback
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GITHUB_REDIRECT_URL=https://trunc.site/github-callback

# Email Configuration (optional - for email verification, notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here

# SMS Configuration (optional - for phone verification)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here

# Redis Configuration
REDIS_PORT=6380

# Security Configuration
ENVIRONMENT=production

# Monitoring (optional)
# SENTRY_DSN=your_sentry_dsn_here
# DATADOG_API_KEY=your_datadog_key_here