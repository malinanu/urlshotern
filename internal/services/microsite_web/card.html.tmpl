{{define "vcard"}}<article class="vc vc-{{.Template}}" data-vc="{{.Template}}" data-nl="{{.NameClass}}" data-logo="{{.LogoPlate}}"{{if .StyleAttr}} style="{{.StyleAttr}}"{{end}}><div class="vc-in"><i class="vc-d vc-d1" aria-hidden="true"></i><i class="vc-d vc-d2" aria-hidden="true"></i><i class="vc-d vc-d3" aria-hidden="true"></i><i class="vc-d vc-d4" aria-hidden="true"></i><header class="vc-top">{{if .Logo}}<span class="vc-logo"><img src="{{.Logo}}" alt="{{if .Company}}{{.Company}} logo{{else}}Company logo{{end}}"></span>{{end}}{{if .Company}}<span class="vc-brand">{{.Company}}</span>{{end}}<span class="vc-tag">DIGITAL ID · {{.IDNumber}}</span></header><figure class="vc-photo">{{if .Photo}}<img src="{{.Photo}}" alt="{{.Name}}">{{else}}<span class="vc-mono" aria-hidden="true">{{.Initials}}</span>{{end}}</figure><div class="vc-who"><h1 class="vc-name">{{.Name}}</h1>{{if .Role}}<p class="vc-role">{{.Role}}</p>{{end}}{{if .Company}}<p class="vc-co">{{.Company}}</p>{{end}}</div>{{if .About}}<p class="vc-about">{{.About}}</p>{{end}}{{if .Tags}}<ul class="vc-tags">{{range .Tags}}<li>{{.}}</li>{{end}}</ul>{{end}}{{if .Rows}}<ul class="vc-list">{{range .Rows}}<li><a class="vc-row vc-row-{{.Kind}}" href="{{.Href}}"{{if .External}} target="_blank" rel="noopener noreferrer"{{end}}><span class="vc-ico">{{.Icon}}</span><span class="vc-lab">{{.Label}}</span><span class="vc-val">{{.Value}}</span></a></li>{{end}}</ul>{{end}}{{if .Socials}}<ul class="vc-soc">{{range .Socials}}<li><a class="vc-s" href="{{.Href}}" data-track="click" data-block="{{.BlockID}}" data-item="{{.ID}}" target="_blank" rel="noopener noreferrer me" title="{{.Name}}" aria-label="{{.Name}}">{{.Glyph}}</a></li>{{end}}</ul>{{end}}<footer class="vc-foot"><div class="vc-qr" role="img" aria-label="QR code for this card">{{if .QRPath}}<svg viewBox="{{.QRViewBox}}" shape-rendering="crispEdges" aria-hidden="true"><path d="{{.QRPath}}"/></svg>{{end}}</div><p class="vc-scan">Scan to connect</p>{{if .HasCTA}}<a class="vc-cta" href="{{.CTAHref}}" rel="nofollow">{{.CTALabel}}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>{{end}}</footer></div></article>{{end}}
