# CloudFlare CDN Configuration
# Copy this file to .env.cloudflare and fill in your actual values

# CloudFlare API Credentials
# Get these from: https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_ZONE_ID=your_zone_id_here
CLOUDFLARE_ACCOUNT_ID=your_account_id_here

# CloudFlare Workers KV Namespace
# Created via: wrangler kv:namespace create "URL_MAPPINGS"
CLOUDFLARE_KV_NAMESPACE_ID=your_kv_namespace_id_here

# Origin Server Configuration
ORIGIN_IP=your_server_public_ip
BASE_URL=https://trunc.site

# CDN Configuration
CDN_PROVIDER=cloudflare  # Options: cloudflare, cloudfront, fastly
CDN_CACHE_TTL=3600       # Default cache TTL in seconds
CDN_ENABLED=true

# Cache Invalidation Settings
CACHE_INVALIDATION_ENABLED=true
CACHE_INVALIDATION_ON_UPDATE=true
CACHE_INVALIDATION_ON_DELETE=true

# Worker Configuration
WORKER_ENVIRONMENT=production  # Options: development, staging, production
WORKER_ANALYTICS_ENABLED=true
WORKER_AB_TESTING_ENABLED=false

# Performance Settings
CACHE_HIT_RATIO_TARGET=0.85  # 85% cache hit ratio target
STALE_WHILE_REVALIDATE=86400 # 24 hours

# Monitoring and Alerts
CLOUDFLARE_ANALYTICS_ENABLED=true
ALERT_LOW_CACHE_HIT_RATIO=0.70  # Alert if cache hit ratio < 70%
ALERT_HIGH_ORIGIN_LOAD=100      # Alert if origin gets > 100 req/s
