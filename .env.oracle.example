# Oracle Server Environment Configuration
# Copy this file to .env and update with your actual values

# Database Configuration (Centralized PostgreSQL)
DB_PASSWORD=URLShortenerSecurePassword123!
DB_USER=urlshortener_user
DB_NAME=urlshortener_db
DB_HOST=postgresql-central
DB_PORT=5432

# Server Configuration
BASE_URL=https://trunc.site
SERVER_PORT=8080
ENVIRONMENT=production
NODE_ID=1

# Frontend Configuration
# CRITICAL: This must match your production domain
# If using port 8082, include it: https://trunc.site:8082
# If using reverse proxy/load balancer, omit port: https://trunc.site
NEXT_PUBLIC_API_URL=https://trunc.site

# JWT Configuration (REQUIRED for authentication)
# SECURITY: Generate a strong secret with: openssl rand -base64 32
JWT_SECRET=your-secret-key-change-this-in-production-generate-with-openssl
JWT_ISSUER=urlshortener

# Connection Pool Settings (Optional - defaults provided)
DB_MAX_CONNECTIONS=25
DB_MAX_IDLE_CONNECTIONS=10
DB_CONN_MAX_LIFETIME=3600
DB_CONN_MAX_IDLE_TIME=600
DB_SSLMODE=disable

# Redis Configuration
REDIS_HOST=urlshortener-redis
REDIS_PORT=6379

# Polar Integration (Optional - for premium features)
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_ORGANIZATION_ID=
POLAR_API_URL=https://api.polar.sh/v1
