# Server Configuration
SERVER_PORT=8080
SERVER_HOST=localhost
BASE_URL=http://localhost:8080
ENVIRONMENT=development

# Frontend Configuration
# IMPORTANT: NEXT_PUBLIC_API_URL must be set during Docker build
# This URL is baked into the frontend static files at build time
NEXT_PUBLIC_API_URL=http://localhost:8080

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=urlshortener
# SECURITY: Use a strong, unique password (minimum 16 characters)
# Generate with: openssl rand -base64 24
DB_PASSWORD=your_secure_database_password_here
DB_NAME=urlshortener_db

# Database Connection Pool Configuration
# Maximum number of open connections to the database
DB_MAX_CONNECTIONS=25
# Maximum number of idle connections in the pool
DB_MAX_IDLE_CONNECTIONS=10
# Maximum lifetime of a connection in seconds (default: 3600 = 1 hour)
DB_CONN_MAX_LIFETIME=3600
# Maximum idle time of a connection in seconds (default: 600 = 10 minutes)
DB_CONN_MAX_IDLE_TIME=600

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# Redis Cluster (optional) — set comma-separated node addresses to enable cluster mode
# e.g. REDIS_CLUSTER_ADDRS=node1:6379,node2:6379,node3:6379
# When set, REDIS_HOST/PORT are ignored.
REDIS_CLUSTER_ADDRS=

# Snowflake Configuration
NODE_ID=1

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# JWT Configuration
JWT_SECRET=your-secret-key-change-this-in-production
JWT_ISSUER=urlshortener

# Polar Payment Gateway Configuration
# Sign up at: https://polar.sh
# Sandbox API (for testing): https://sandbox-api.polar.sh/v1
# Production API (for live): https://api.polar.sh/v1
POLAR_ACCESS_TOKEN=polar_oat_your_access_token_here
POLAR_WEBHOOK_SECRET=polar_whs_your_webhook_secret_here
POLAR_ORGANIZATION_ID=your_organization_id_here
POLAR_API_URL=https://sandbox-api.polar.sh/v1

# Note: The products endpoint (/api/v1/products) is public and does not require authentication.
# This allows users to view pricing information before signing up.
# User-specific billing endpoints (/api/v1/billing/*) remain protected and require authentication.

# Webhook Alert Configuration
# Comma-separated list of email addresses to receive webhook failure alerts
WEBHOOK_ALERT_EMAILS=ops@example.com,admin@example.com

# Admin Panel Control (default: false for security)
# Set to true to enable admin routes at /api/v1/admin/*
# Recommended: Keep false in production, enable only when admin access needed
ENABLE_ADMIN_ROUTES=false

# Microsites — micro-landing pages and digital vCards at /m/<slug> (default: false)
# When false, none of the /m/*, /api/v1/microsites/* or /api/v1/m/* routes are registered.
# Requires migration 046_microsites_up.sql.
ENABLE_MICROSITES=false
# Directory for uploaded page images (mount a persistent volume here in Docker)
MICROSITE_UPLOAD_PATH=./uploads
# Maximum image upload size in bytes (default 2 MB)
MICROSITE_MAX_UPLOAD_BYTES=2097152

# Email Configuration (SMTP)
# SMTP server configuration for sending emails
SMTP_HOST=mail.trunc.site
SMTP_PORT=587
SMTP_USERNAME=noreply@trunc.site
SMTP_PASSWORD=your_smtp_password_here

# Email sender information
FROM_EMAIL=noreply@trunc.site
FROM_NAME=trunc.site

# Note: Email links (verification, password reset, etc.) use BASE_URL configured above

# Optional: MaxMind GeoLite2 database for high-accuracy local GeoIP lookups.
# Download from https://dev.maxmind.com/geoip/geolite2-free-geolocation-data
# Without this, the free API fallback (ip-api.com) is used automatically.
GEOIP_DB_PATH=

# AI Insights (OpenRouter — free tier available at openrouter.ai)
# Required for Ultra-plan AI features. Use model: google/gemma-3-4b-it:free
OPENROUTER_API_KEY=sk-or-...

# VirusTotal (spam/malicious URL detection on shorten)
# Sign up at: https://www.virustotal.com/gui/join-us — free tier is 4 req/min
# Without this, spam/virus link checks are silently skipped.
VIRUSTOTAL_API_KEY=

# SMS — text.lk (Sri Lankan numbers, +94)
# Sign up at: https://app.text.lk  →  Developers → API Token
TEXTLK_API_KEY=your_textlk_api_token_here
# Sender ID must be pre-approved by text.lk (max 11 characters)
TEXTLK_SENDER_ID=TRUNC

# SMS — Twilio (international numbers)
# Sign up at: https://www.twilio.com/console
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
# A verified Twilio phone number in E.164 format, e.g. +12015551234
TWILIO_FROM_NUMBER=+1xxxxxxxxxx

# GitHub OAuth Configuration (optional — for GitHub SSO)
# Create an OAuth App at: https://github.com/settings/applications/new
# Homepage URL: http://localhost:8080
# Authorization callback URL: http://localhost:8080/api/v1/auth/github/callback
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GITHUB_REDIRECT_URL=http://localhost:8080/api/v1/auth/github/callback