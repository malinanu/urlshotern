# Server Configuration
SERVER_PORT=8080
SERVER_HOST=localhost
BASE_URL=http://localhost:8080
ENVIRONMENT=development

# Frontend Configuration
# IMPORTANT: NEXT_PUBLIC_API_URL must be set during Docker build
# This URL is baked into the frontend static files at build time
NEXT_PUBLIC_API_URL=http://localhost:8080

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=urlshortener
# SECURITY: Use a strong, unique password (minimum 16 characters)
# Generate with: openssl rand -base64 24
DB_PASSWORD=your_secure_database_password_here
DB_NAME=urlshortener_db

# Database Connection Pool Configuration
# Maximum number of open connections to the database
DB_MAX_CONNECTIONS=25
# Maximum number of idle connections in the pool
DB_MAX_IDLE_CONNECTIONS=10
# Maximum lifetime of a connection in seconds (default: 3600 = 1 hour)
DB_CONN_MAX_LIFETIME=3600
# Maximum idle time of a connection in seconds (default: 600 = 10 minutes)
DB_CONN_MAX_IDLE_TIME=600

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Snowflake Configuration
NODE_ID=1

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# JWT Configuration
JWT_SECRET=your-secret-key-change-this-in-production
JWT_ISSUER=urlshortener

# Polar Payment Gateway Configuration
# Sign up at: https://polar.sh
# Sandbox API (for testing): https://sandbox-api.polar.sh/v1
# Production API (for live): https://api.polar.sh/v1
POLAR_ACCESS_TOKEN=polar_oat_your_access_token_here
POLAR_WEBHOOK_SECRET=polar_whs_your_webhook_secret_here
POLAR_ORGANIZATION_ID=your_organization_id_here
POLAR_API_URL=https://sandbox-api.polar.sh/v1

# Note: The products endpoint (/api/v1/products) is public and does not require authentication.
# This allows users to view pricing information before signing up.
# User-specific billing endpoints (/api/v1/billing/*) remain protected and require authentication.

# Webhook Alert Configuration
# Comma-separated list of email addresses to receive webhook failure alerts
WEBHOOK_ALERT_EMAILS=ops@example.com,admin@example.com