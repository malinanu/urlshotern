  "components": [
    {
      "name": "Save Contact bar",
      "kind": "button",
      "refersTo": "save-contact-bar",
      "description": "The letterpress card's painted foot; downloads the owner's vCard.",
      "html": "<div class=\"ds-lp-card\"><p class=\"ds-lp-name\">Sasha Fields</p><a class=\"ds-lp-bar\" href=\"#\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2\"/><circle cx=\"9\" cy=\"7\" r=\"4\"/><path d=\"M19 8v6M22 11h-6\"/></svg>SAVE CONTACT</a></div>",
      "css": ".ds-lp-card{width:300px;border:6px solid #2340d6;border-radius:12px;background:#fff;overflow:hidden;box-shadow:0 2px 3px rgba(0,0,0,.06),0 22px 44px -22px rgba(0,0,0,.4);font-family:'Schibsted Grotesk',system-ui,sans-serif}.ds-lp-name{margin:24px 20px 40px;font-size:36px;font-weight:800;letter-spacing:-.025em;color:#14161c;text-shadow:0 1px 0 rgba(255,255,255,.85),0 -1px 1px rgba(0,0,0,.16)}.ds-lp-bar{display:flex;align-items:center;justify-content:center;gap:10px;height:66px;background:#2340d6;color:#fff;font-size:14px;font-weight:700;letter-spacing:.14em;text-decoration:none}.ds-lp-bar:hover{background:#1c33ab}.ds-lp-bar:focus-visible{outline:3px solid #14161c;outline-offset:-6px}"
    },
    {
      "name": "Contact row",
      "kind": "custom",
      "refersTo": "ink",
      "description": "Typeset contact action on the card's back: line icon, label, chevron, hairline.",
      "html": "<a class=\"ds-lp-row\" href=\"#\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#2340d6\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z\"/></svg>Call<span class=\"ds-chev\" aria-hidden=\"true\">\u203a</span></a>",
      "css": ".ds-lp-row{display:flex;align-items:center;gap:14px;width:280px;padding:14px 2px;border-bottom:1px solid #e2e4ea;color:#14161c;font:600 16px 'Schibsted Grotesk',system-ui,sans-serif;text-decoration:none}.ds-chev{margin-left:auto;color:#6b6f7a;font-size:20px}.ds-lp-row:hover{color:#2340d6}.ds-lp-row:focus-visible{outline:2px solid #2340d6;outline-offset:2px}"
    },
    {
      "name": "Boarding row",
      "kind": "custom",
      "refersTo": "board-row-boarding",
      "description": "The newest link on the departure board, with destination, via host and status chip.",
      "html": "<div class=\"ds-board\"><a class=\"ds-brd-now\" href=\"#\"><span class=\"ds-dest\">MY LATEST VIDEO</span><span class=\"ds-chip\">NOW BOARDING</span><span class=\"ds-via\">youtube.com</span></a><a class=\"ds-brd-row\" href=\"#\"><span class=\"ds-dest\">THE PODCAST</span><span class=\"ds-via\">example.com</span></a></div>",
      "css": ".ds-board{width:340px;background:#1b2a6b;font-family:'Martian Mono',ui-monospace,monospace}.ds-brd-now,.ds-brd-row{display:grid;grid-template-columns:1fr auto;grid-template-areas:'dest chip' 'via via';gap:4px 10px;padding:13px 18px;text-decoration:none;border-bottom:1px solid rgba(255,255,255,.18)}.ds-brd-now{background:#ffd400;padding:18px}.ds-dest{grid-area:dest;font-size:15px;font-weight:600;letter-spacing:.02em;color:#fff}.ds-brd-now .ds-dest{font-size:19px;color:#1b2a6b}.ds-via{grid-area:via;font-size:11px;letter-spacing:.06em;color:rgba(255,255,255,.72)}.ds-brd-now .ds-via{color:#1b2a6b}.ds-chip{grid-area:chip;align-self:center;font-size:11px;letter-spacing:.08em;padding:3px 7px;border-radius:2px;background:#1b2a6b;color:#ffd400}.ds-brd-row:hover .ds-dest{text-decoration:underline}.ds-brd-now:focus-visible,.ds-brd-row:focus-visible{outline:3px solid #ffd400;outline-offset:-3px}"
    },
    {
      "name": "Flyer product with burst",
      "kind": "card",
      "refersTo": "flyer-burst",
      "description": "Price-led product tile: thick accent rule, condensed name, superscript cents, twelve-point burst.",
      "html": "<article class=\"ds-fl-prod\"><span class=\"ds-burst\">SAVE 20%</span><h2 class=\"ds-fl-name\">YOUR BEST SELLER</h2><p class=\"ds-fl-price\"><span class=\"ds-cur\">$</span><span class=\"ds-amt\">24</span><span class=\"ds-cents\">.99</span> <s>$31.00</s></p><a class=\"ds-fl-buy\" href=\"#\">BUY NOW</a></article>",
      "css": ".ds-fl-prod{position:relative;width:300px;margin-top:60px;padding-top:12px;border-top:6px solid #d7261e;font-family:'Barlow Condensed','Arial Narrow',sans-serif;color:#17181c}.ds-fl-name{margin:0;padding-right:78px;font-size:20px;font-weight:800;line-height:1}.ds-fl-price{margin:8px 0;color:#961b15;font-weight:800}.ds-cur{font-size:20px;vertical-align:top}.ds-amt{font-size:76px;line-height:.85;letter-spacing:-.02em}.ds-cents{font-size:30px;vertical-align:top}.ds-fl-price s{font-size:18px;color:#6b6b6b;margin-left:8px}.ds-fl-buy{display:block;padding:12px;background:#d7261e;color:#fff;text-align:center;font-size:17px;font-weight:800;letter-spacing:.03em;border-radius:2px;text-decoration:none}.ds-fl-buy:hover{background:#961b15}.ds-fl-buy:focus-visible{outline:3px solid #17181c;outline-offset:2px}.ds-burst{position:absolute;top:-58px;right:-4px;width:76px;height:76px;display:flex;align-items:center;justify-content:center;padding:14px;text-align:center;font-size:13px;font-weight:800;line-height:1;color:#fff;transform:rotate(-8deg);isolation:isolate;background:linear-gradient(#961b15,#961b15) center/70.72% 70.72% no-repeat}.ds-burst::before,.ds-burst::after{content:'';position:absolute;inset:14.64%;background:#961b15;z-index:-1;transform:rotate(30deg)}.ds-burst::after{transform:rotate(60deg)}"
    },
    {
      "name": "Programme actions",
      "kind": "button",
      "refersTo": "programme-tickets",
