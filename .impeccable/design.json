      "css": ".ds-pg-act{display:grid;grid-template-columns:1fr 1fr;gap:10px;width:340px;font-family:'Hanken Grotesk',system-ui,sans-serif}.ds-pg-btn{display:flex;align-items:center;justify-content:center;padding:12px 10px;border-radius:4px;border:1.5px solid #111318;color:#111318;font-size:15px;font-weight:600;white-space:nowrap;text-decoration:none}.ds-pg-primary{background:#0e7c66;border-color:#0e7c66;color:#fff}.ds-pg-btn:hover{background:#f1f3f2}.ds-pg-primary:hover{background:#0b6553}.ds-pg-btn:focus-visible{outline:3px solid #0e7c66;outline-offset:2px}"
    },
