      "css": ".ds-pg-row{display:grid;grid-template-columns:56px 4px 1fr;gap:14px;width:340px;padding:12px 0;border-bottom:1px solid #e3e5e8;font-family:'Hanken Grotesk',system-ui,sans-serif;color:#111318;font-variant-numeric:tabular-nums}.ds-pg-row time{font-weight:700;font-size:15px}.ds-trk{background:#0e7c66;border-radius:1px}.ds-pg-row strong{display:block;font-size:16px}.ds-pg-row span{display:block;font-size:14px;color:#3d4148}.ds-pg-row small{display:block;margin-top:2px;font-size:11px;font-weight:700;letter-spacing:.08em;color:#5b6068}"
    }
  ],
  "narrative": {
    "northStar": "The owner's page, printed",
    "overview": "Each template is a printed object the visitor already knows how to read: a business card, a departure board, a weekly flyer, a conference programme. The owner's four color tokens paint it, one self-hosted face sets it, and the server renders it from validated data. The classic card stays exactly as it was for existing pages.",
    "keyCharacteristics": [
      "One world per template, not one skeleton reskinned",
      "Owner tokens drive every color",
      "One OFL face per style, preloaded only when used",
      "Click-to-load media, no third-party code until asked",
      "Byte-identical classic output"
    ],
    "rules": [
      {
        "name": "The Owner's Brand Rule",
        "body": "No template hard-codes its signature color; defaults only seed a new page.",
        "section": "colors"
      },
      {
        "name": "The Contrast Floor",
        "body": "Text sits on a flat field; layered paint is drawn as separate layers, never as a gradient behind text.",
        "section": "colors"
      },
      {
        "name": "One Face",
        "body": "Each style loads exactly one self-hosted face; other scripts fall back to the system stack.",
        "section": "typography"
      },
      {
        "name": "Held Object",
        "body": "Only the letterpress card casts a shadow.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do derive extra colors from the owner's tokens",
      "Do give each new block a rule in every style sheet or the shared blocks.css look",
      "Do keep functional text at 11px or larger"
    ],
    "donts": [
      "Don't put text on a gradient",
      "Don't use eyebrows, colored side-borders or icon tiles",
      "Don't draw organic shapes with many-vertex clip-path",
      "Don't change the classic style's output"
    ]
  }
}