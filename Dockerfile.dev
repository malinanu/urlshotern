FROM golang:1.24.1-alpine

WORKDIR /app

# Install Node.js, npm, and git for development tools
RUN apk add --no-cache nodejs npm git

# Install air for hot reloading (compatible version)
# Use direct mode to bypass proxy issues
RUN GOPROXY=direct go install github.com/cosmtrek/air@v1.49.0

# Copy go mod files
COPY go.mod go.sum ./

# Download Go dependencies
RUN go mod download

# Copy frontend package files
COPY frontend/package*.json ./frontend/

# Install frontend dependencies
RUN cd frontend && npm ci

# Copy source code (both Go and frontend)
COPY . .

# Accept build arguments for Next.js public environment variables
ARG NEXT_PUBLIC_API_URL
ARG BASE_URL
ARG NODE_ENV=production

# Build frontend for production with environment variables
RUN cd frontend && \
    NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL} \
    BASE_URL=${BASE_URL} \
    NODE_ENV=${NODE_ENV} \
    npm run build

# Create static directory and copy built frontend
RUN mkdir -p /app/static

# Copy static export from Next.js build
# With output: 'export', Next.js generates static files in frontend/out/
RUN if [ -d "/app/frontend/out" ]; then \
    echo "Copying Next.js static export from /app/frontend/out/"; \
    cp -rv /app/frontend/out/* /app/static/; \
    ls -la /app/static/; \
else \
    echo "ERROR: /app/frontend/out directory not found!"; \
    echo "Next.js build may have failed or output mode is not set to 'export'"; \
    exit 1; \
fi

# Verify critical files exist
RUN if [ ! -f "/app/static/index.html" ]; then \
    echo "ERROR: index.html not found in /app/static/"; \
    ls -la /app/static/; \
    exit 1; \
fi

RUN echo "Frontend build copied successfully."

# Expose port
EXPOSE 8080

# Install PostgreSQL client for migrations
RUN apk add --no-cache postgresql-client

# Copy migration scripts
COPY scripts/ /app/scripts/
COPY configs/migrations/ /app/configs/migrations/
RUN find /app/scripts -name "*.sh" -exec sed -i 's/\r$//' {} \; && chmod +x /app/scripts/*.sh

# Copy and set entrypoint script
COPY docker/entrypoint.sh /entrypoint.sh
RUN sed -i 's/\r$//' /entrypoint.sh && chmod +x /entrypoint.sh

# Use entrypoint to run migrations before starting app
ENTRYPOINT ["/entrypoint.sh"]

# Use air for hot reloading in development
CMD ["air"]